{
  "name": "pasteinto",
  "private": true,
  "description": "Tests + lint scaffolding. The site itself stays static files with no build step; the same files are the Chrome extension.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:spell": "cspell \"**/*.{html,js,md,json}\"",
    "lint:html": "html-validate index.html",
    "stamp": "node scripts/stamp.mjs",
    "pack:extension": "node scripts/pack-extension.mjs"
  },
  "devDependencies": {
    "cspell": "^8.0.0",
    "html-validate": "^8.0.0",
    "jsdom": "^24.0.0",
    "vitest": "^1.6.0"
  }
}
